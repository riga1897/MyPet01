# ================================================================
# ШАБЛОН Ansible inventory
#
# В CI/CD (workflow_dispatch) inventory.ini генерируется АВТОМАТИЧЕСКИ
# из GitHub Secrets — вручную редактировать не нужно.
#
# Для запуска Ansible ЛОКАЛЬНО (с VPS3 или своей машины):
#   cp ansible/inventory.ini.example ansible/inventory.ini
#   # Вставь реальные IP вместо YOUR_VPS*_IP
#   ansible-playbook site.yml --ask-vault-pass
#
# ansible/inventory.ini добавлен в .gitignore — в git не попадёт.
# ================================================================

[prod]
# VPS1 — Продакшн (новый сервер VDSka)
# ЗАМЕНИТЬ на реальный IP после создания:
YOUR_VPS1_IP ansible_user=root ansible_ssh_private_key_file=~/.ssh/id_rsa

[backup]
# VPS2 — Холодный резерв + Бэкапы
# Ресурсы: 4 CPU / 4 GB RAM / 80 GB SSD (идентично VPS1)
# ЗАМЕНИТЬ на реальный IP после создания:
YOUR_VPS2_IP ansible_user=root ansible_ssh_private_key_file=~/.ssh/id_rsa

[management]
# VPS3 — Управление (Ansible control node, Prometheus, Grafana)
# Ресурсы: 2 CPU / 2 GB RAM / 40 GB SSD
# ЗАМЕНИТЬ на реальный IP после создания:
YOUR_VPS3_IP ansible_user=root ansible_ssh_private_key_file=~/.ssh/id_rsa

[all:vars]
ansible_python_interpreter=/usr/bin/python3
