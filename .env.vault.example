# .env.vault.example — шаблон для локальной генерации ansible/vault.yml
#
# Использование:
#   cp .env.vault.example .env.vault
#   # заполни реальными значениями
#   source .env.vault && bash scripts/generate-vault.sh
#
# .env.vault добавлен в .gitignore — в git не попадёт

# PostgreSQL
export VAULT_DB_USER="blog_user"
export VAULT_DB_NAME="blog_db"
export VAULT_DB_PASSWORD="ЗАМЕНИ-НА-РЕАЛЬНЫЙ-ПАРОЛЬ"

# PostgreSQL Replication (hot standby VPS2)
export VAULT_PG_REPLICATION_PASSWORD="ЗАМЕНИ-НА-РЕАЛЬНЫЙ-ПАРОЛЬ"

# Grafana
export VAULT_GRAFANA_PASSWORD="ЗАМЕНИ-НА-РЕАЛЬНЫЙ-ПАРОЛЬ"

# Semaphore
export VAULT_SEMAPHORE_ADMIN_PASSWORD="ЗАМЕНИ-НА-РЕАЛЬНЫЙ-ПАРОЛЬ"

# S3 (опционально — заполнить после выбора провайдера)
export VAULT_S3_ACCESS_KEY=""
export VAULT_S3_SECRET_KEY=""

# Telegram алерты (опционально)
export VAULT_TELEGRAM_TOKEN=""
export VAULT_TELEGRAM_CHAT_ID=""

# SSH ключ с VPS3 для управления VPS1 и VPS2
# Скопировать вывод: cat ~/.ssh/ansible_id_rsa
export VAULT_SSH_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----
ВСТАВИТЬ ПРИВАТНЫЙ КЛЮЧ СЮДА
-----END OPENSSH PRIVATE KEY-----"
